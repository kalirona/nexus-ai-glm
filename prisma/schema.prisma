// NexusAI — AI Business Operating System
// Production-grade schema. SQLite-compatible (no enums / arrays; use strings + JSON).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A platform user. In MVP we operate with a single local workspace user,
/// but the schema supports multi-tenant scaling from day one.
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  avatarUrl       String?
  plan            String   @default("free") // free | starter | pro | agency
  credits         Int      @default(200)
  creditsResetAt  DateTime?
  role            String   @default("owner") // owner | admin | member
  isAdmin         Boolean  @default(false) // platform super admin
  status          String   @default("active") // active | suspended | banned
  clerkId         String?  @unique // Legacy Clerk ID — will be migrated to logtoId
  logtoId         String?  @unique // Logto user ID for auth
  preferences     String?  // JSON-encoded notification preferences
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  folders         Folder[]
  chats           Chat[]
  documents       Document[]
  images          Image[]
  brandVoices     BrandVoice[]
  transactions    CreditTransaction[]
  auditLogs       AuditLog[]
  apiKeys         ApiKey[]
  history         GeneratorHistory[]
}

model Folder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  icon      String   @default("folder")
  kind      String   @default("chat") // chat | document
  parentId  String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats     Chat[]
  documents Document[]
}

model Chat {
  id        String    @id @default(cuid())
  userId    String
  folderId  String?
  title     String
  model     String    @default("auto")
  pinned    Boolean   @default(false)
  archived  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder    Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages  Message[]

  @@index([userId, updatedAt])
  @@index([userId, pinned])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  role      String // user | assistant | system
  content   String
  model     String?
  tokens    Int?
  createdAt DateTime @default(now())

  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  folderId  String?
  title     String
  content   String
  kind      String   @default("generic") // generic | business-plan | contract | email | blog | sales-copy | report
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder    Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions  DocumentVersion[]

  @@index([userId, updatedAt])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  content    String
  version    Int
  createdAt  DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, version])
}

model Image {
  id        String   @id @default(cuid())
  userId    String
  prompt    String
  size      String   @default("1024x1024")
  base64    String
  kind      String   @default("graphic") // graphic | logo | ad | social | thumbnail | hero
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int // negative = spend, positive = grant
  reason    String // chat | image | document | grant | refill
  refId     String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String // chat.create | image.generate | document.generate ...
  resource  String
  resourceId String?
  meta      String? // JSON string
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  name      String
  hashedKey String
  prefix    String
  lastUsedAt DateTime?
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Template {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  category        String
  description     String
  icon            String
  kind            String   @default("document")
  systemPrompt    String
  userPromptTpl   String
  fields          String? // JSON string of variable definitions
  createdAt       DateTime @default(now())
}

model Agent {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String
  systemPrompt String
  icon         String
  category     String
  capabilities String? // JSON string
  createdAt    DateTime @default(now())
}

/// Brand Voice profiles — reusable across chat, documents, marketing.
model BrandVoice {
  id           String   @id @default(cuid())
  userId       String
  name         String
  description  String?
  tone         String   @default("professional, confident")
  vocabulary   String?  // comma-separated preferred words
  avoidWords   String?  // comma-separated forbidden words
  sampleCopy   String?
  systemPrompt String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Persists recent generator outputs (SEO / Marketing / YouTube) so users can
/// revisit them across devices/sessions. Capped client-side at ~10 per module.
model GeneratorHistory {
  id           String   @id @default(cuid())
  userId       String
  module       String   // seo | marketing | youtube
  tool         String   // tool id (e.g. "keywords", "fb-ad", "titles")
  toolLabel    String   // human-readable tool name
  input        String   // short summary of the input that produced this
  result       String   // the full markdown result
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, module, createdAt])
  @@index([userId, createdAt])
}

/// Platform-wide key-value settings managed by super admins.
/// Stores AI provider keys, enabled models, security & performance config.
model PlatformSetting {
  key       String   @id
  value     String   // JSON-encoded value (API keys are encrypted)
  updatedAt DateTime @updatedAt
}

/// Logs every AI request for usage analytics, cost tracking, and debugging.
model AiUsageLog {
  id            String   @id @default(cuid())
  userId        String?
  provider      String   // provider id (zai, openrouter, openai, …)
  model         String   // model id sent to the provider
  requestType   String   // chat | image | document | embedding
  promptTokens  Int      @default(0)
  completionTokens Int   @default(0)
  totalTokens   Int      @default(0)
  cost          Float    @default(0)
  durationMs    Int      @default(0)
  success       Boolean  @default(true)
  errorMessage  String?
  streaming     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([provider, createdAt])
  @@index([model, createdAt])
  @@index([userId, createdAt])
}

/// Centralized prompt management for each AI type.
/// Stores versioned system prompts with enable/disable and audit trail.
model PromptConfig {
  id          String   @id @default(cuid())
  aiType      String   // chat | image | document | ocr | speech-to-text | text-to-speech | code | translation | summarization | custom
  name        String   // display name
  content     String   // the system prompt text
  version     Int      @default(1)
  isActive    Boolean  @default(true) // only one active per aiType
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([aiType, isActive])
  @@index([aiType, version])
}
/// Layer 1: Provider Catalog — every model returned by the provider (verificationStatus = "unverified")
/// Layer 2: Verified — credentials confirmed usable (verificationStatus = "verified")
/// Layer 3: Approved — admin-approved for user visibility (approved = true)
model AiModel {
  id                 String   @id @default(cuid())
  providerId         String   // provider id (zai, openrouter, openai, …)
  modelId            String   // the model ID sent to the provider
  displayName        String   // display name
  providerName       String   // provider display name
  owner              String?  // model owner (e.g. "openai", "anthropic", "meta")
  category           String?  // chat, image, embedding, audio, etc.
  contextWindow      Int?
  maxOutputTokens    Int?
  inputCostPerM      Float?   // $ per 1M input tokens
  outputCostPerM     Float?   // $ per 1M output tokens
  supportsStreaming  Boolean  @default(true)
  supportsVision     Boolean  @default(false)
  supportsFunctionCalling Boolean @default(false)
  supportsJsonMode   Boolean  @default(false)
  supportsEmbeddings Boolean  @default(false)
  supportsAudio      Boolean  @default(false)
  supportsImages     Boolean  @default(false)
  supportsVideo      Boolean  @default(false)
  supportsReasoning  Boolean  @default(false)
  capabilityTags     String?  // JSON array of tags
  // Three-layer state
  verificationStatus String   @default("unverified") // unverified | verified | unavailable | deprecated | preview | private | disabled-by-provider
  enabled            Boolean  @default(true)  // enabled for routing
  approved           Boolean  @default(false) // approved for user visibility
  isDefault          Boolean  @default(false) // default for a capability
  defaultCapability  String?  // which capability this is the default for
  // Health
  healthStatus       String   @default("unknown") // unknown | healthy | slow | degraded | offline
  avgLatencyMs       Int?
  lastHealthCheck    DateTime?
  // Sync metadata
  lastSyncAt         DateTime?
  lastVerifiedAt     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([providerId, modelId])
  @@index([providerId])
  @@index([approved, enabled])
  @@index([verificationStatus])
  @@index([isDefault])
}
