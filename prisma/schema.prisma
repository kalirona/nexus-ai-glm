// NexusAI — AI Business Operating System
// Production-grade schema. SQLite-compatible (no enums / arrays; use strings + JSON).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A platform user. In MVP we operate with a single local workspace user,
/// but the schema supports multi-tenant scaling from day one.
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  avatarUrl       String?
  plan            String   @default("free") // free | starter | pro | agency
  credits         Int      @default(200)
  creditsResetAt  DateTime?
  role            String   @default("owner") // owner | admin | member
  isAdmin         Boolean  @default(false) // platform super admin
  status          String   @default("active") // active | suspended | banned
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  folders         Folder[]
  chats           Chat[]
  documents       Document[]
  images          Image[]
  brandVoices     BrandVoice[]
  transactions    CreditTransaction[]
  auditLogs       AuditLog[]
  apiKeys         ApiKey[]
}

model Folder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  icon      String   @default("folder")
  kind      String   @default("chat") // chat | document
  parentId  String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats     Chat[]
  documents Document[]
}

model Chat {
  id        String    @id @default(cuid())
  userId    String
  folderId  String?
  title     String
  model     String    @default("auto")
  pinned    Boolean   @default(false)
  archived  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder    Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages  Message[]

  @@index([userId, updatedAt])
  @@index([userId, pinned])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  role      String // user | assistant | system
  content   String
  model     String?
  tokens    Int?
  createdAt DateTime @default(now())

  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  folderId  String?
  title     String
  content   String
  kind      String   @default("generic") // generic | business-plan | contract | email | blog | sales-copy | report
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder    Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions  DocumentVersion[]

  @@index([userId, updatedAt])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  content    String
  version    Int
  createdAt  DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, version])
}

model Image {
  id        String   @id @default(cuid())
  userId    String
  prompt    String
  size      String   @default("1024x1024")
  base64    String
  kind      String   @default("graphic") // graphic | logo | ad | social | thumbnail | hero
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int // negative = spend, positive = grant
  reason    String // chat | image | document | grant | refill
  refId     String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String // chat.create | image.generate | document.generate ...
  resource  String
  resourceId String?
  meta      String? // JSON string
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  name      String
  hashedKey String
  prefix    String
  lastUsedAt DateTime?
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Template {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  category        String
  description     String
  icon            String
  kind            String   @default("document")
  systemPrompt    String
  userPromptTpl   String
  fields          String? // JSON string of variable definitions
  createdAt       DateTime @default(now())
}

model Agent {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String
  systemPrompt String
  icon         String
  category     String
  capabilities String? // JSON string
  createdAt    DateTime @default(now())
}

/// Brand Voice profiles — reusable across chat, documents, marketing.
model BrandVoice {
  id           String   @id @default(cuid())
  userId       String
  name         String
  description  String?
  tone         String   @default("professional, confident")
  vocabulary   String?  // comma-separated preferred words
  avoidWords   String?  // comma-separated forbidden words
  sampleCopy   String?
  systemPrompt String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Platform-wide key-value settings managed by super admins.
/// Stores AI provider keys, enabled models, security & performance config.
model PlatformSetting {
  key       String   @id
  value     String   // JSON-encoded value
  updatedAt DateTime @updatedAt
}
