DATABASE_URL=file:/home/z/my-project/db/custom.db

# ═══════════════════════════════════════════════════════════
# AUTH MODE — controls authentication behavior
# ═══════════════════════════════════════════════════════════
# "demo" = sandbox/preview mode (demo user fallback active, no Clerk needed)
# "clerk" = production mode (requires Clerk session, fails closed if missing)
#
# DEFAULT: "demo" in development, "clerk" in production (via NODE_ENV)
# To force: set explicitly below
AUTH_MODE=demo

# ═══════════════════════════════════════════════════════════
# CLERK AUTHENTICATION (required when AUTH_MODE=clerk)
# ═══════════════════════════════════════════════════════════
# Get these from https://dashboard.clerk.com → API Keys
#
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ═══════════════════════════════════════════════════════════
# CLERK WEBHOOK (required for user synchronization)
# ═══════════════════════════════════════════════════════════
# Get from Clerk Dashboard → Webhooks → Endpoint → Signing Secret
# When NOT set, webhook accepts unsigned requests (demo/dev only)
#
CLERK_WEBHOOK_SECRET=

# ═══════════════════════════════════════════════════════════
# ENCRYPTION KEY (required in production)
# ═══════════════════════════════════════════════════════════
# Used for AES-256-GCM encryption of API keys at rest.
# Generate with: openssl rand -hex 32
# When NOT set in production: app throws fatal error (fail closed)
# When NOT set in development: uses dev fallback (with warning)
#
ENCRYPTION_KEY=
