DATABASE_URL=postgresql://nexusai:YOUR_PASSWORD@localhost:5432/nexusai

# Auth Mode: "demo" (sandbox) or "logto" (production)
AUTH_MODE=demo

# ─── Logto Authentication ───
# Get these from your Logto application settings
LOGTO_ENDPOINT=https://logto.yourdomain.com
LOGTO_APP_ID=
LOGTO_APP_SECRET=                    # Server-side only — NEVER use NEXT_PUBLIC_
LOGTO_BASE_URL=https://nexusai.yourdomain.com
LOGTO_COOKIE_SECRET=                 # Generate: openssl rand -hex 32

# ─── Encryption (server-side only) ───
# Encryption key for API keys at rest (generate: openssl rand -hex 32)
ENCRYPTION_KEY=

# ─── Directus (optional — Phase 1.2 POC only) ───
# Directus server URL (server-side only — NEVER exposed to browser)
DIRECTUS_URL=
# Directus service token (server-side only — NEVER exposed to browser)
DIRECTUS_SERVICE_TOKEN=

# ─── Data Migration (temporary — used by scripts/migrate-sqlite-to-postgres.ts) ───
# Points to the OLD SQLite database for one-time data migration
# After migration is complete, this can be removed
SQLITE_DATABASE_URL=file:db/custom.db
