DATABASE_URL=file:/app/data/nexus.db

# Auth Mode: "demo" (sandbox) or "clerk" (production)
AUTH_MODE=demo

# Clerk (required when AUTH_MODE=clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Encryption key for API keys at rest (generate: openssl rand -hex 32)
ENCRYPTION_KEY=

# ─── Directus (Phase 1.2 — Infrastructure Proof of Concept) ───
# Directus server URL (server-side only — NEVER exposed to browser)
# Example: http://nexusai-directus:8055 (Docker internal) or https://directus.yourdomain.com
DIRECTUS_URL=

# Directus service token (server-side only — NEVER exposed to browser)
# Generate in Directus Admin → Settings → API Tokens → Create Token (Admin role)
DIRECTUS_SERVICE_TOKEN=
